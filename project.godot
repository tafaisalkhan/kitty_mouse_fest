; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[application]

config/name="Kitty Hunt: Eat and Grow"
run/main_scene="res://scenes/menus/Boot.tscn"
config/use_custom_user_dir=true
config/custom_user_dir_name="Godot/app_userdata/Kitty Rescue- Dig to Mom"
config/features=PackedStringArray("4.7", "GL Compatibility")
boot_splash/bg_color=Color(0.04, 0.63, 0.96, 1)
boot_splash/image="res://assets/branding/white-ball-icon.png"
config/icon="res://assets/branding/white-ball-icon.png"

[autoload]

SaveManager="*res://scripts/core/SaveManager.gd"
AudioManager="*res://scripts/core/AudioManager.gd"
LevelService="*res://scripts/generation/LevelService.gd"
SessionDiagnostics="*res://scripts/core/SessionDiagnostics.gd"
PlatformServices="*res://scripts/core/PlatformServices.gd"
AdsService="*res://scripts/core/AdsService.gd"
Economy="*res://scripts/core/Economy.gd"

[display]

window/size/viewport_width=720
window/size/viewport_height=1280
window/size/window_width_override=450
window/size/window_height_override=800
window/stretch/mode="canvas_items"
window/stretch/aspect="ignore"
window/handheld/orientation=1

[gui]

theme/custom="res://assets/ui/game_theme.tres"

[input_devices]

sensors/enable_accelerometer=true
sensors/enable_gravity=true

[physics]

common/physics_interpolation=true

[rendering]

renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
textures/vram_compression/import_etc2_astc=true
environment/defaults/default_clear_color=Color(0.035, 0.38, 0.63, 1)
